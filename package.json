{
  "name": "juego-familia-ech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-pwa-icons.mjs && next dev",
    "build": "node scripts/generate-pwa-icons.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/hooks/*.test.ts",
    "test:e2e:mobile": "playwright test",
    "test:smoke:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "test:worker-security": "node --test worker/test/*.test.mjs",
    "test:integration:security": "node scripts/security-smoke.mjs",
    "build:cloudflare": "node scripts/generate-pwa-icons.mjs && opennextjs-cloudflare build",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:web": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "test:special:cloudflare": "node scripts/special-rounds-smoke.mjs",
    "test:special:content:cloudflare": "node scripts/special-content-smoke.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "@playwright/test": "^1.56.0",
    "@types/qrcode": "^1.5.5",
    "@opennextjs/cloudflare": "1.20.8",
    "wrangler": "4.147.0"
  }
}
